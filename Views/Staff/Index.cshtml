@model List<Appointment.Models.AppointmentModel>
@{
    ViewData["Title"] = "Kênh Nhân viên hỗ trợ";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1 text-dark">
            <i class="bi bi-person-badge text-info me-2"></i>Kênh Nhân Viên Hỗ Trợ (Staff Portal)
        </h3>
        <p class="text-secondary small mb-0">Tiếp nhận khách hàng, điều phối lịch hẹn, hỗ trợ bác sĩ và in phiếu dịch vụ tại quầy</p>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
    <form asp-action="Index" method="get" class="row g-3 align-items-end">
        <div class="col-md-5">
            <label class="form-label small fw-bold text-secondary">
                <i class="bi bi-funnel me-1"></i>Lọc theo trạng thái
            </label>
            <select name="status" class="form-select rounded-3" onchange="this.form.submit()">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="Pending" selected="@(ViewBag.StatusFilter == "Pending" ? "selected" : null)">Pending (Chờ xác nhận)</option>
                <option value="Confirmed" selected="@(ViewBag.StatusFilter == "Confirmed" ? "selected" : null)">Confirmed (Đã xác nhận)</option>
                <option value="Completed" selected="@(ViewBag.StatusFilter == "Completed" ? "selected" : null)">Completed (Hoàn thành)</option>
                <option value="Cancelled" selected="@(ViewBag.StatusFilter == "Cancelled" ? "selected" : null)">Cancelled (Đã hủy)</option>
            </select>
        </div>
        <div class="col-md-5">
            <label class="form-label small fw-bold text-secondary">
                <i class="bi bi-calendar-event me-1"></i>Lọc theo ngày tiếp nhận
            </label>
            <input type="date" name="date" class="form-control rounded-3" value="@ViewBag.DateFilter" onchange="this.form.submit()" />
        </div>
        <div class="col-md-2">
            <a asp-action="Index" class="btn btn-outline-secondary w-100 rounded-3">
                <i class="bi bi-arrow-counterclockwise me-1"></i>Đặt lại
            </a>
        </div>
    </form>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
    <div class="card-header bg-slate-50 py-3 px-4 d-flex justify-content-between align-items-center border-bottom">
        <h5 class="fw-bold mb-0 text-dark">
            <i class="bi bi-list-stars me-1 text-primary"></i>Danh Sách Lịch Hẹn Đang Phụ Trách (@Model.Count)
        </h5>
    </div>

    @if (!Model.Any())
    {
        <div class="p-5 text-center text-muted">
            <i class="bi bi-inbox display-4 text-secondary mb-2 d-block"></i>
            <h6 class="fw-bold text-dark">Không có cuộc hẹn nào</h6>
            <small>Chưa có lịch hẹn nào phù hợp với bộ lọc.</small>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Khách hàng</th>
                        <th>Dịch vụ & Nhà cung cấp</th>
                        <th>Ngày & Khung giờ</th>
                        <th>Nhân viên tiếp nhận</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-dark">@item.Customer?.FullName</div>
                                <div class="text-secondary small">
                                    <i class="bi bi-telephone text-muted me-1"></i>@(item.Customer?.PhoneNumber ?? "Chưa có SĐT")
                                </div>
                            </td>
                            <td>
                                <strong class="text-dark">@item.Service?.Name</strong>
                                <div class="text-secondary small">
                                    <i class="bi bi-building text-muted me-1"></i>@item.Provider?.FullName
                                </div>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@item.AppointmentDate.ToString("dd/MM/yyyy")</div>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-clock me-1 text-muted"></i>@item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")
                                </span>
                            </td>
                            <td>
                                @if (item.Staff != null)
                                {
                                    <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">
                                        <i class="bi bi-person-check-fill me-1"></i>@item.Staff.FullName
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border px-2 py-1">Chưa phân công</span>
                                }
                            </td>
                            <td>
                                @if (item.Status == "Pending")
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">Chờ xác nhận</span>
                                }
                                else if (item.Status == "Confirmed")
                                {
                                    <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">Đã xác nhận</span>
                                }
                                else if (item.Status == "Completed")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Đã hoàn thành</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">Đã hủy</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-1 align-items-center">
                                    @if (string.IsNullOrEmpty(item.StaffId))
                                    {
                                        <form asp-action="AssignStaff" method="post" class="d-inline">
                                            <input type="hidden" name="appointmentId" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3 fw-bold">
                                                <i class="bi bi-hand-index-thumb me-1"></i>Tiếp nhận
                                            </button>
                                        </form>
                                    }

                                    <!-- Print Voucher / Invoice Button -->
                                    <a asp-controller="Appointments" asp-action="PrintInvoice" asp-route-id="@item.Id" target="_blank" class="btn btn-sm btn-outline-secondary rounded-pill px-2" title="In Phiếu Hẹn / Hóa Đơn">
                                        <i class="bi bi-printer-fill"></i>
                                    </a>

                                    @if (item.Status == "Confirmed")
                                    {
                                        <form asp-action="UpdateStatus" method="post" class="d-inline">
                                            <input type="hidden" name="appointmentId" value="@item.Id" />
                                            <input type="hidden" name="status" value="Completed" />
                                            <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 fw-bold">Hoàn tất</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
