@model Appointment.Models.ViewModels.WalkInBookingViewModel
@{
    ViewData["Title"] = "Đặt lịch hẹn tại quầy (Walk-in Booking)";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1 text-dark">
            <i class="bi bi-person-plus-fill text-primary me-2"></i>Đặt Lịch Hẹn Tại Quầy (Walk-in Booking)
        </h3>
        <p class="text-secondary small mb-0">Tiếp nhận khách vãng lai, tự động tạo hồ sơ khách hàng và in ngay phiếu hẹn / số thứ tự</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
        </a>
    </div>
</div>

<form asp-action="WalkInBooking" method="post" id="walkInForm">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-4" role="alert"></div>

    <div class="row g-4">
        <!-- Cột 1: Thông tin khách hàng -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <h5 class="fw-bold text-dark border-bottom pb-3 mb-3">
                    <i class="bi bi-person-vcard text-primary me-2"></i>1. Thông Tin Khách Hàng
                </h5>

                <div class="mb-3">
                    <label asp-for="PhoneNumber" class="form-label fw-bold small text-dark">
                        Số điện thoại khách hàng <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-telephone"></i>
                        </span>
                        <input asp-for="PhoneNumber" id="customerPhone" class="form-control border-start-0 rounded-end-3" placeholder="Ví dụ: 0912345678" autofocus />
                    </div>
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    <div id="lookupAlert" class="small mt-1 text-success fw-semibold" style="display: none;">
                        <i class="bi bi-check-circle-fill me-1"></i>Đã tìm thấy thông tin khách hàng cũ trong hệ thống!
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="CustomerName" class="form-label fw-bold small text-dark">
                        Họ và tên khách hàng <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-person"></i>
                        </span>
                        <input asp-for="CustomerName" id="customerName" class="form-control border-start-0 rounded-end-3" placeholder="Nhập họ và tên đầy đủ" />
                    </div>
                    <span asp-validation-for="CustomerName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-bold small text-dark">
                        Địa chỉ Email <span class="text-muted fw-normal">(Không bắt buộc)</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-envelope"></i>
                        </span>
                        <input asp-for="Email" id="customerEmail" type="email" class="form-control border-start-0 rounded-end-3" placeholder="tenkhach@gmail.com" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Address" class="form-label fw-bold small text-dark">
                        Địa chỉ nơi ở
                    </label>
                    <input asp-for="Address" id="customerAddress" class="form-control rounded-3" placeholder="Số nhà, đường, phường/xã, quận/huyện..." />
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>

                <div class="p-3 bg-light rounded-3 text-secondary small mt-auto border">
                    <i class="bi bi-info-circle text-primary me-1"></i>
                    <em>Nếu khách hàng chưa từng có tài khoản, hệ thống sẽ tự động tạo hồ sơ khách hàng mới với số điện thoại này.</em>
                </div>
            </div>
        </div>

        <!-- Cột 2: Chọn dịch vụ & Bác sĩ tiếp nhận & Khung giờ theo ca cố định -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <h5 class="fw-bold text-dark border-bottom pb-3 mb-3">
                    <i class="bi bi-clipboard2-check text-success me-2"></i>2. Dịch Vụ & Khung Giờ Khám Theo Ca
                </h5>

                <div class="mb-3">
                    <label asp-for="ServiceId" class="form-label fw-bold small text-dark">
                        Chọn dịch vụ phục vụ <span class="text-danger">*</span>
                    </label>
                    <select asp-for="ServiceId" id="selectService" asp-items="Model.ServicesList" class="form-select rounded-3">
                        <option value="">-- Chọn dịch vụ --</option>
                    </select>
                    <span asp-validation-for="ServiceId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ProviderId" class="form-label fw-bold small text-dark">
                        Bác sĩ / Chuyên gia tiếp nhận <span class="text-muted fw-normal">(Mặc định theo dịch vụ)</span>
                    </label>
                    <select asp-for="ProviderId" id="selectProvider" asp-items="Model.ProvidersList" class="form-select rounded-3">
                        <option value="">-- Mặc định theo bác sĩ của dịch vụ --</option>
                    </select>
                    <span asp-validation-for="ProviderId" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="AppointmentDate" class="form-label fw-bold small text-dark">
                            Ngày hẹn khám / phục vụ <span class="text-danger">*</span>
                        </label>
                        <input asp-for="AppointmentDate" id="appointmentDate" type="date" class="form-control rounded-3" value="@Model.AppointmentDate.ToString("yyyy-MM-dd")" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="AppointmentDate" class="text-danger small"></span>
                    </div>

                    <div class="col-sm-6">
                        <label class="form-label fw-bold small text-dark">
                            Thời lượng quy định
                        </label>
                        <div class="p-2 px-3 bg-light border rounded-3 d-flex align-items-center justify-content-between">
                            <span class="small text-secondary"><i class="bi bi-stopwatch text-primary me-1"></i>Mỗi ca:</span>
                            <span id="serviceDurationBadge" class="badge bg-primary text-white font-monospace">-- phút / ca</span>
                        </div>
                    </div>
                </div>

                <!-- Khung giờ theo ca cố định tăng dần (Giống Đặt Lịch Online) -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label fw-bold small text-dark mb-0">
                            <i class="bi bi-clock-history me-1 text-primary"></i>Chọn khung giờ phục vụ <span class="text-danger">*</span>
                        </label>
                        <span id="slotStatusHint" class="small text-secondary">Đang tải ca...</span>
                    </div>

                    <!-- Hidden input nhận giá trị khung giờ được click chọn -->
                    <input type="hidden" asp-for="SelectedTimeSlot" id="selectedTimeSlotInput" value="@Model.SelectedTimeSlot" />
                    <span asp-validation-for="SelectedTimeSlot" class="text-danger small d-block mb-1"></span>

                    <div id="slotsGrid" class="row g-2 p-2 bg-light rounded-3 border" style="min-height: 120px; max-height: 250px; overflow-y: auto;">
                        <div class="col-12 py-4 text-center text-muted small">
                            <i class="bi bi-arrow-repeat spin me-1"></i>Đang tải các mốc thời gian...
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Status" class="form-label fw-bold small text-dark">
                        Trạng thái tiếp nhận ban đầu
                    </label>
                    <select asp-for="Status" class="form-select rounded-3">
                        <option value="Confirmed" selected>Confirmed (Đã xác nhận - Chờ vào phòng khám)</option>
                        <option value="In-Progress">In-Progress (Đang thực hiện dịch vụ ngay)</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="Notes" class="form-label fw-bold small text-dark">
                        Yêu cầu / Triệu chứng của khách
                    </label>
                    <textarea asp-for="Notes" rows="2" class="form-control rounded-3" placeholder="Nhập triệu chứng sơ bộ hoặc yêu cầu của khách tại quầy..."></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="InternalNote" class="form-label fw-bold small text-dark">
                        <i class="bi bi-shield-lock text-warning me-1"></i>Ghi chú nghiệp vụ nội bộ <span class="badge bg-warning-subtle text-warning-emphasis">US-42</span>
                    </label>
                    <textarea asp-for="InternalNote" rows="2" class="form-control rounded-3" placeholder="Ghi chú sở thích, lưu ý tiền sử, thói quen cho Bác sĩ & Nhân viên xem..."></textarea>
                </div>
            </div>
        </div>

        <!-- Thanh nút điều hướng -->
        <div class="col-12 text-end">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white d-flex flex-row justify-content-between align-items-center">
                <span class="text-muted small ps-2">
                    <i class="bi bi-printer me-1"></i>Hệ thống sẽ tự động chuyển sang trang in <strong>Phiếu Hẹn & Số Thứ Tự</strong> ngay sau khi lưu.
                </span>
                <div class="d-flex gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Hủy</a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Tạo Lịch & In Phiếu Hẹn</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // 1. Tự động tra cứu khách hàng qua SĐT
        const phoneInput = document.getElementById('customerPhone');
        const nameInput = document.getElementById('customerName');
        const emailInput = document.getElementById('customerEmail');
        const addressInput = document.getElementById('customerAddress');
        const lookupAlert = document.getElementById('lookupAlert');

        let timeout = null;
        phoneInput.addEventListener('input', function () {
            clearTimeout(timeout);
            const phone = this.value.trim();
            if (phone.length >= 9) {
                timeout = setTimeout(() => {
                    fetch('/Staff/LookupCustomer?phone=' + encodeURIComponent(phone))
                        .then(res => res.json())
                        .then(data => {
                            if (data.found) {
                                if (!nameInput.value || nameInput.value.trim() === '') {
                                    nameInput.value = data.fullName;
                                }
                                if (!emailInput.value || emailInput.value.trim() === '') {
                                    emailInput.value = data.email || '';
                                }
                                if (!addressInput.value || addressInput.value.trim() === '') {
                                    addressInput.value = data.address || '';
                                }
                                lookupAlert.style.display = 'block';
                            } else {
                                lookupAlert.style.display = 'none';
                            }
                        })
                        .catch(() => {
                            lookupAlert.style.display = 'none';
                        });
                }, 400);
            } else {
                lookupAlert.style.display = 'none';
            }
        });

        // 2. Tính toán & hiển thị mốc thời gian cố định theo từng loại dịch vụ (Giống Đặt Lịch Online)
        const selectService = document.getElementById('selectService');
        const selectProvider = document.getElementById('selectProvider');
        const appointmentDate = document.getElementById('appointmentDate');
        const selectedSlotInput = document.getElementById('selectedTimeSlotInput');
        const slotsGrid = document.getElementById('slotsGrid');
        const slotDurationBadge = document.getElementById('serviceDurationBadge');
        const slotStatusHint = document.getElementById('slotStatusHint');

        function loadAvailableSlots() {
            const serviceId = selectService.value;
            const providerId = selectProvider.value;
            const date = appointmentDate.value;

            if (!serviceId) {
                slotsGrid.innerHTML = '<div class="col-12 py-4 text-center text-muted small"><i class="bi bi-info-circle me-1"></i>Vui lòng chọn dịch vụ để tải khung giờ.</div>';
                slotDurationBadge.innerText = '-- phút / ca';
                slotStatusHint.innerText = '';
                return;
            }

            slotsGrid.innerHTML = '<div class="col-12 py-4 text-center text-muted small"><span class="spinner-border spinner-border-sm me-2"></span>Đang phân ca và tính mốc thời gian...</div>';

            fetch(`/Staff/GetAvailableSlots?serviceId=${encodeURIComponent(serviceId)}&providerId=${encodeURIComponent(providerId)}&date=${encodeURIComponent(date)}`)
                .then(res => res.json())
                .then(data => {
                    if (!data.success) {
                        slotsGrid.innerHTML = `<div class="col-12 py-4 text-center text-danger small">${data.message || 'Lỗi khi tải ca.'}</div>`;
                        return;
                    }

                    slotDurationBadge.innerText = `${data.durationMinutes} phút / ca`;

                    if (data.isOffDay) {
                        slotsGrid.innerHTML = `<div class="col-12 py-4 text-center text-danger small"><i class="bi bi-calendar-x me-1"></i>Bác sĩ nghỉ: ${data.offDayReason || 'Không phục vụ'}</div>`;
                        slotStatusHint.innerText = 'Ngày nghỉ';
                        selectedSlotInput.value = '';
                        return;
                    }

                    if (!data.slots || data.slots.length === 0) {
                        slotsGrid.innerHTML = '<div class="col-12 py-4 text-center text-muted small"><i class="bi bi-calendar-minus me-1"></i>Không có khung giờ làm việc nào trong ngày này.</div>';
                        slotStatusHint.innerText = 'Hết ca';
                        selectedSlotInput.value = '';
                        return;
                    }

                    let html = '';
                    let availableCount = 0;
                    const currentValue = selectedSlotInput.value;

                    data.slots.forEach(slot => {
                        if (slot.isAvailable) {
                            availableCount++;
                            const isSelected = (currentValue === slot.time);
                            html += `
                                <div class="col-6 col-sm-4">
                                    <button type="button" 
                                            class="btn w-100 py-2 small fw-bold rounded-3 slot-item-btn ${isSelected ? 'btn-primary text-white shadow-sm' : 'btn-outline-primary bg-white'}" 
                                            data-time="${slot.time}">
                                        <i class="bi bi-clock me-1"></i>${slot.display}
                                    </button>
                                </div>`;
                        } else {
                            html += `
                                <div class="col-6 col-sm-4">
                                    <button type="button" 
                                            class="btn btn-outline-secondary w-100 py-2 small rounded-3 opacity-50 disabled" 
                                            disabled 
                                            title="Khung giờ đã có người đặt hoặc đã qua">
                                        ${slot.display} <small class="d-block text-muted" style="font-size: 0.7rem;">(Kín/Qua)</small>
                                    </button>
                                </div>`;
                        }
                    });

                    slotsGrid.innerHTML = html;
                    slotStatusHint.innerHTML = `<span class="text-success fw-bold">${availableCount}</span> ca còn trống`;

                    // Gắn sự kiện click chọn ca
                    document.querySelectorAll('.slot-item-btn').forEach(btn => {
                        btn.addEventListener('click', function () {
                            document.querySelectorAll('.slot-item-btn').forEach(b => {
                                b.classList.remove('btn-primary', 'text-white', 'shadow-sm');
                                b.classList.add('btn-outline-primary', 'bg-white');
                            });
                            this.classList.remove('btn-outline-primary', 'bg-white');
                            this.classList.add('btn-primary', 'text-white', 'shadow-sm');
                            selectedSlotInput.value = this.getAttribute('data-time');
                        });
                    });

                    // Nếu đã có slot được chọn trước đó và vẫn hợp lệ
                    if (currentValue) {
                        const activeBtn = document.querySelector(`.slot-item-btn[data-time="${currentValue}"]`);
                        if (activeBtn) {
                            activeBtn.click();
                        } else {
                            selectedSlotInput.value = '';
                        }
                    }
                })
                .catch(err => {
                    slotsGrid.innerHTML = '<div class="col-12 py-4 text-center text-danger small">Lỗi kết nối khi tải danh sách ca.</div>';
                });
        }

        selectService.addEventListener('change', loadAvailableSlots);
        selectProvider.addEventListener('change', loadAvailableSlots);
        appointmentDate.addEventListener('change', loadAvailableSlots);

        // Tải ca ngay khi trang vừa mở
        document.addEventListener('DOMContentLoaded', loadAvailableSlots);
    </script>
}
