@model List<Appointment.Models.Review>
@{
    ViewData["Title"] = "Đánh giá từ khách hàng";
    double avg = Model.Any() ? Model.Average(r => r.Rating) : 0;
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1 text-dark"><i class="bi bi-star-fill text-warning me-2"></i>Đánh Giá Từ Khách Hàng</h3>
        <p class="text-secondary small mb-0">Phản hồi về chất lượng các dịch vụ của bạn</p>
    </div>
    @if (Model.Any())
    {
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <button id="btnAiAnalyze" class="btn btn-primary rounded-pill px-3 py-2 fw-semibold shadow-sm d-flex align-items-center gap-2">
                <i class="bi bi-robot fs-5"></i>
                <span>AI Phân Tích Đánh Giá</span>
            </button>
            <div class="card border-0 shadow-sm rounded-4 px-4 py-2 bg-white text-center">
                <div class="fs-3 fw-extrabold text-dark">@avg.ToString("0.0") <small class="fs-6 text-muted">/ 5</small></div>
                <partial name="_RatingStars" model="avg" />
                <div class="small text-muted">@Model.Count đánh giá</div>
            </div>
        </div>
    }
</div>

<!-- US-AI-03: AI Phân Tích Đánh Giá Khách Hàng -->
<div id="aiAnalysisCard" class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4 d-none">
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div class="d-flex align-items-center gap-2">
            <div class="bg-primary-subtle text-primary p-2 rounded-3">
                <i class="bi bi-stars fs-4"></i>
            </div>
            <div>
                <h5 class="fw-bold mb-0 text-dark">Báo Cáo Phân Tích AI & Đề Xuất Cải Thiện</h5>
                <small class="text-secondary">Trích xuất tự động từ toàn bộ nhận xét thực tế của khách hàng</small>
            </div>
        </div>
        <button id="btnCloseAiAnalysis" class="btn btn-sm btn-light rounded-circle text-muted" title="Đóng">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>
    
    <div id="aiAnalysisLoading" class="text-center py-4 d-none">
        <div class="spinner-border text-primary mb-2" role="status"></div>
        <div class="text-secondary small">AI đang tổng hợp dữ liệu phản hồi...</div>
    </div>
    
    <div id="aiAnalysisContent" class="p-3 bg-light rounded-3 text-dark small" style="white-space: pre-wrap; line-height: 1.6;">
    </div>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
        <div class="mb-3 text-secondary" style="font-size: 3rem;"><i class="bi bi-chat-square-heart"></i></div>
        <h5 class="fw-bold text-dark">Chưa có đánh giá nào</h5>
        <p class="text-secondary small mb-0">Khách hàng có thể đánh giá sau khi lịch hẹn được đánh dấu hoàn thành.</p>
    </div>
}
else
{
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr><th class="ps-4">Dịch vụ</th><th>Khách hàng</th><th>Điểm</th><th>Nhận xét</th><th>Ngày</th></tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-dark">@r.Service?.Name</td>
                            <td>@r.Customer?.FullName</td>
                            <td><partial name="_RatingStars" model="(double)r.Rating" /> <small class="text-muted">@r.Rating/5</small></td>
                            <td class="small text-secondary" style="max-width: 360px;">@(string.IsNullOrWhiteSpace(r.Comment) ? "—" : r.Comment)</td>
                            <td class="small text-muted">@r.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const btn = document.getElementById("btnAiAnalyze");
        const card = document.getElementById("aiAnalysisCard");
        const loading = document.getElementById("aiAnalysisLoading");
        const content = document.getElementById("aiAnalysisContent");
        const btnClose = document.getElementById("btnCloseAiAnalysis");

        if (btnClose && card) {
            btnClose.addEventListener("click", () => card.classList.add("d-none"));
        }

        if (btn) {
            btn.addEventListener("click", function () {
                card.classList.remove("d-none");
                loading.classList.remove("d-none");
                content.innerHTML = "";
                btn.disabled = true;

                fetch('/Ai/AnalyzeReviews')
                    .then(res => res.json())
                    .then(data => {
                        loading.classList.add("d-none");
                        btn.disabled = false;
                        if (data && data.success) {
                            content.innerHTML = data.analysis;
                        } else {
                            content.innerHTML = `<span class="text-danger"><i class="bi bi-exclamation-triangle me-1"></i>${data.message || 'Không thể lấy phân tích lúc này.'}</span>`;
                        }
                    })
                    .catch(err => {
                        loading.classList.add("d-none");
                        btn.disabled = false;
                        content.innerHTML = `<span class="text-danger"><i class="bi bi-exclamation-circle me-1"></i>Lỗi kết nối máy chủ.</span>`;
                    });
            });
        }
    });
</script>
}
