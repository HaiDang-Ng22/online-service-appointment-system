@model Appointment.Models.Service
@{
    ViewData["Title"] = "Chỉnh sửa dịch vụ";
    var categories = ViewBag.Categories as List<Appointment.Models.Category> ?? new();
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="fw-bold mb-0">Chỉnh Sửa Dịch Vụ</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="EditService" asp-route-id="@Model.Id" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="ProviderId" />

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Tên dịch vụ</label>
                        <input asp-for="Name" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="CategoryId" class="form-label fw-semibold">Danh mục</label>
                        <select asp-for="CategoryId" class="form-select" required>
                            @foreach (var c in categories)
                            {
                                <option value="@c.Id" selected="@(Model.CategoryId == c.Id ? "selected" : null)">@c.Name</option>
                            }
                        </select>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Price" class="form-label fw-semibold">Giá dịch vụ (VNĐ)</label>
                            <input asp-for="Price" type="number" step="1000" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DurationMinutes" class="form-label fw-semibold">Thời lượng (Phút)</label>
                            <input asp-for="DurationMinutes" type="number" class="form-control" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Location" class="form-label fw-semibold">Địa điểm thực hiện</label>
                        <input asp-for="Location" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Mô tả dịch vụ</label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label">Hoạt động (Cho phép hiển thị & đặt lịch)</label>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Services" class="btn btn-outline-secondary">Hủy</a>
                        <button type="submit" class="btn btn-primary fw-bold px-4">Cập Nhật Dịch Vụ</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
