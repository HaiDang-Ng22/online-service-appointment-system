@model List<Appointment.Models.User>
@{
    ViewData["Title"] = "Quản lý nhân viên";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1 text-primary">Danh Sách Nhân Viên</h3>
        <p class="text-muted small mb-0">Quản lý và cấp tài khoản nhân viên tiếp nhận lịch hẹn tại quầy</p>
    </div>
    <a asp-action="CreateStaff" class="btn btn-primary fw-bold rounded-pill px-3 py-2 shadow-sm d-flex align-items-center gap-1.5">
        <i class="bi bi-person-plus-fill"></i>
        <span>Thêm Nhân Viên Mới</span>
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Họ và tên</th>
                    <th>Email đăng nhập</th>
                    <th>Số điện thoại</th>
                    <th>Địa chỉ</th>
                    <th>Ngày tạo</th>
                    <th class="text-center">Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-people fs-1 d-block mb-2 text-secondary"></i>
                            Chưa có tài khoản nhân viên nào. Hãy nhấn <strong>"Thêm Nhân Viên Mới"</strong> để cấp tài khoản.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var staff in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                        @(string.IsNullOrEmpty(staff.FullName) ? "N" : staff.FullName.Substring(0, 1).ToUpper())
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">@staff.FullName</div>
                                        <small class="text-muted">Nhân viên tiếp nhận</small>
                                    </div>
                                </div>
                            </td>
                            <td><span class="text-secondary">@staff.Email</span></td>
                            <td>@(string.IsNullOrEmpty(staff.PhoneNumber) ? "-" : staff.PhoneNumber)</td>
                            <td>@(string.IsNullOrEmpty(staff.Address) ? "-" : staff.Address)</td>
                            <td>@staff.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">
                                @if (staff.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1 rounded-pill">Bị khóa</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
