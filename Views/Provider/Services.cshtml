@model List<Appointment.Models.Service>
@{
    ViewData["Title"] = "Quản lý dịch vụ";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0 text-primary">Dịch Vụ Của Tôi</h3>
    <a asp-action="CreateService" class="btn btn-primary fw-bold">Tạo Dịch Vụ Mới</a>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Tên dịch vụ</th>
                    <th>Danh mục</th>
                    <th>Giá</th>
                    <th>Thời lượng</th>
                    <th>Địa điểm</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@item.Name</td>
                        <td><span class="badge bg-secondary-subtle text-secondary">@item.Category?.Name</span></td>
                        <td class="text-success fw-bold">@item.Price.ToString("N0") VNĐ</td>
                        <td>@item.DurationMinutes phút</td>
                        <td>@item.Location</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success">Đang hoạt động</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Đã ẩn</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="EditService" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
