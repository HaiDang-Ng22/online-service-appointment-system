@model List<Appointment.Models.Review>
@{
    ViewData["Title"] = "Quản Lý Đánh Giá Toàn Hệ Thống";
    var providers = ViewBag.ProvidersList as List<Appointment.Models.User> ?? new List<Appointment.Models.User>();
    var providerRatingStats = ViewBag.ProviderRatingStats as dynamic;
    string selectedProvId = ViewBag.SelectedProviderId as string ?? "";
    int? selectedRating = ViewBag.SelectedRating as int?;
    double avgSystem = Model.Any() ? Math.Round(Model.Average(r => r.Rating), 1) : 0;
    int satisfiedTotal = Model.Count(r => r.Rating >= 4);
    double satisfiedRate = Model.Count > 0 ? Math.Round((double)satisfiedTotal / Model.Count * 100, 1) : 0;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1 text-primary">
            <i class="bi bi-star-fill text-warning me-2"></i>Quản Lý Đánh Giá Toàn Hệ Thống
        </h3>
        <p class="text-muted small mb-0">Giám sát chất lượng dịch vụ, thống kê số sao và thông tin phản hồi từ khách hàng</p>
    </div>
</div>

<!-- 3 THẺ TỔNG QUAN HỆ THỐNG -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3 rounded-4 bg-white h-100 border-start border-4 border-warning">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <small class="text-muted fw-semibold">Điểm Đánh Giá Trung Bình</small>
                    <h3 class="fw-bold mb-0 text-dark mt-1">@avgSystem.ToString("0.0") <small class="fs-6 text-muted">/ 5.0</small></h3>
                </div>
                <div class="rounded-circle bg-warning-subtle text-warning-emphasis p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="bi bi-star-fill fs-5"></i>
                </div>
            </div>
            <div class="mt-2 pt-2 border-top">
                <partial name="_RatingStars" model="avgSystem" />
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3 rounded-4 bg-white h-100 border-start border-4 border-primary">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <small class="text-muted fw-semibold">Tổng Số Lượt Đánh Giá</small>
                    <h3 class="fw-bold mb-0 text-primary mt-1">@Model.Count</h3>
                </div>
                <div class="rounded-circle bg-primary-subtle text-primary p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="bi bi-chat-heart-fill fs-5"></i>
                </div>
            </div>
            <small class="text-muted mt-2 d-block border-top pt-2" style="font-size: 0.75rem;">Từ các cuộc hẹn đã hoàn thành</small>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3 rounded-4 bg-white h-100 border-start border-4 border-success">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <small class="text-muted fw-semibold">Tỷ Lệ Hài Lòng (4-5 Sao)</small>
                    <h3 class="fw-bold mb-0 text-success mt-1">@satisfiedRate%</h3>
                </div>
                <div class="rounded-circle bg-success-subtle text-success p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="bi bi-hand-thumbs-up-fill fs-5"></i>
                </div>
            </div>
            <div class="progress mt-2" style="height: 6px;">
                <div class="progress-bar bg-success" style="width: @satisfiedRate%"></div>
            </div>
        </div>
    </div>
</div>

<!-- BẢNG THỐNG KÊ SỐ SAO TỪNG NHÀ CUNG CẤP -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
    <div class="card-header bg-white py-3 px-4 border-bottom d-flex align-items-center justify-content-between">
        <div>
            <h6 class="fw-bold mb-0 text-dark">
                <i class="bi bi-hospital text-warning me-2"></i>Thống Kê Điểm Số & Đánh Giá Từng Nhà Cung Cấp
            </h6>
            <small class="text-muted">Đánh giá chất lượng phục vụ của từng đối tác dựa trên dữ liệu khách hàng</small>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Tên Nhà Cung Cấp / Cơ Sở</th>
                    <th class="text-center">Số lượt đánh giá</th>
                    <th>Điểm trung bình</th>
                    <th class="text-center">Tỷ lệ hài lòng (≥4★)</th>
                    <th class="text-end pe-4">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (providerRatingStats != null)
                {
                    foreach (var p in providerRatingStats)
                    {
                        double pAvg = (double)p.AverageRating;
                        double pSat = (double)p.SatisfiedRate;
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-warning-subtle text-warning-emphasis fw-bold d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                        <i class="bi bi-hospital"></i>
                                    </div>
                                    <span class="fw-bold text-dark">@p.ProviderName</span>
                                </div>
                            </td>
                            <td class="text-center fw-bold">@p.ReviewCount</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="fw-bold text-dark fs-6">@pAvg.ToString("0.0")</span>
                                    <partial name="_RatingStars" model="pAvg" />
                                </div>
                            </td>
                            <td class="text-center">
                                <span class="badge @(pSat >= 80 ? "bg-success-subtle text-success" : pSat >= 50 ? "bg-warning-subtle text-warning-emphasis" : "bg-danger-subtle text-danger") border px-2 py-1 rounded-pill">
                                    @pSat%
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="Reviews" asp-route-providerId="@p.ProviderId" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                    <i class="bi bi-funnel me-1"></i>Lọc đánh giá
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- BỘ LỌC ĐÁNH GIÁ -->
<div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
    <form asp-action="Reviews" method="get" class="row g-2 align-items-center">
        <div class="col-md-5">
            <label class="form-label small fw-bold text-muted mb-1">Lọc theo Nhà Cung Cấp:</label>
            <select name="providerId" class="form-select form-select-sm rounded-3">
                <option value="">-- Tất cả nhà cung cấp --</option>
                @foreach (var prov in providers)
                {
                    <option value="@prov.Id" selected="@(selectedProvId == prov.Id ? "selected" : null)">@prov.FullName</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label small fw-bold text-muted mb-1">Lọc theo số sao:</label>
            <select name="rating" class="form-select form-select-sm rounded-3">
                <option value="">-- Tất cả số sao (1 đến 5 sao) --</option>
                <option value="5" selected="@(selectedRating == 5 ? "selected" : null)">⭐⭐⭐⭐⭐ 5 sao</option>
                <option value="4" selected="@(selectedRating == 4 ? "selected" : null)">⭐⭐⭐⭐ 4 sao</option>
                <option value="3" selected="@(selectedRating == 3 ? "selected" : null)">⭐⭐⭐ 3 sao</option>
                <option value="2" selected="@(selectedRating == 2 ? "selected" : null)">⭐⭐ 2 sao</option>
                <option value="1" selected="@(selectedRating == 1 ? "selected" : null)">⭐ 1 sao</option>
            </select>
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <button type="submit" class="btn btn-sm btn-primary w-100 py-1.5 fw-bold rounded-3 shadow-sm d-flex align-items-center justify-content-center gap-1.5">
                <i class="bi bi-filter"></i>
                <span>Áp dụng lọc</span>
            </button>
        </div>
    </form>
</div>

<!-- BẢNG CHI TIẾT TỪNG ĐÁNH GIÁ (HIỂN THỊ RÕ TÊN NGƯỜI VIẾT ĐÁNH GIÁ CHO ADMIN) -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
    <div class="card-header bg-white py-3 px-4 border-bottom d-flex align-items-center justify-content-between">
        <h6 class="fw-bold mb-0 text-dark">
            <i class="bi bi-chat-quote-fill text-primary me-2"></i>Chi Tiết Từng Nhận Xét Của Khách Hàng (@Model.Count)
        </h6>
        <span class="text-muted small">Admin có quyền xem đầy đủ danh tính người viết đánh giá</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Người viết đánh giá (Khách hàng)</th>
                    <th>Nhà Cung Cấp</th>
                    <th>Dịch vụ</th>
                    <th>Điểm sao</th>
                    <th>Nội dung nhận xét</th>
                    <th class="text-end pe-4">Ngày gửi</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                            Không tìm thấy đánh giá nào phù hợp với bộ lọc.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                        @(string.IsNullOrEmpty(r.Customer?.FullName) ? "K" : r.Customer.FullName.Substring(0, 1).ToUpper())
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">@(r.Customer?.FullName ?? "Khách hàng ẩn danh")</div>
                                        <small class="text-muted">@(r.Customer?.Email ?? "-")</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-hospital me-1"></i>@(r.Service?.Provider?.FullName ?? "-")
                                </span>
                            </td>
                            <td>
                                <span class="fw-semibold text-secondary">@(r.Service?.Name ?? "-")</span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-1.5">
                                    <partial name="_RatingStars" model="(double)r.Rating" />
                                    <span class="fw-bold text-dark ms-1 small">@r.Rating/5</span>
                                </div>
                            </td>
                            <td class="small text-dark" style="max-width: 380px;">
                                <div class="p-2 bg-light rounded-3">
                                    @(string.IsNullOrWhiteSpace(r.Comment) ? "Không có lời bình luận." : r.Comment)
                                </div>
                            </td>
                            <td class="text-end pe-4 small text-muted">
                                @r.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
