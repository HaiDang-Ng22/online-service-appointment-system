@model List<Appointment.Models.AppointmentModel>
@{
    ViewData["Title"] = "Trang Admin - Tổng quan hệ thống";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1 text-danger">Bảng Điều Khiển Quản Trị Viên (Admin)</h3>
        <p class="text-muted small mb-0">Trung tâm điều hành và giám sát toàn bộ hoạt động hệ sinh thái AppointX</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Statistics" class="btn btn-primary fw-bold rounded-pill px-3 py-2 shadow-sm d-flex align-items-center gap-1.5">
            <i class="bi bi-graph-up-arrow"></i>
            <span>Thống Kê Doanh Thu & Lịch Hẹn</span>
        </a>
        <a asp-action="CreateUser" class="btn btn-warning text-dark fw-bold rounded-pill px-3 py-2 shadow-sm d-flex align-items-center gap-1.5">
            <i class="bi bi-person-plus-fill"></i>
            <span>Tạo Tài Khoản Mới</span>
        </a>
    </div>
</div>

<!-- 4 THẺ TỔNG QUAN HỆ THỐNG -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 rounded-4 bg-primary text-white h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h2 class="fw-bold mb-0">@ViewBag.TotalUsers</h2>
                    <small>Tổng tài khoản hệ thống</small>
                </div>
                <div class="rounded-circle bg-white text-primary p-3 d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px;">
                    <i class="bi bi-people-fill fs-5"></i>
                </div>
            </div>
            <div class="mt-2 pt-2 border-top border-white-50 small">
                Khách: @ViewBag.TotalCustomers | NCC: @ViewBag.TotalProviders | NV: @ViewBag.TotalStaff
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 rounded-4 bg-success text-white h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h2 class="fw-bold mb-0">@ViewBag.TotalServices</h2>
                    <small>Dịch vụ niêm yết</small>
                </div>
                <div class="rounded-circle bg-white text-success p-3 d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px;">
                    <i class="bi bi-card-checklist fs-5"></i>
                </div>
            </div>
            <div class="mt-2 pt-2 border-top border-white-50 small">
                Trên toàn bộ các danh mục
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 rounded-4 bg-info text-white h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h2 class="fw-bold mb-0">@ViewBag.TotalAppointments</h2>
                    <small>Tổng cuộc hẹn</small>
                </div>
                <div class="rounded-circle bg-white text-info p-3 d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px;">
                    <i class="bi bi-calendar-check-fill fs-5"></i>
                </div>
            </div>
            <div class="mt-2 pt-2 border-top border-white-50 small">
                Đã hoàn thành: @ViewBag.CompletedAppointments ca
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 rounded-4 bg-warning text-dark h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h2 class="fw-bold mb-0">@ViewBag.PendingAppointments</h2>
                    <small>Lịch hẹn chờ duyệt</small>
                </div>
                <div class="rounded-circle bg-white text-warning p-3 d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px;">
                    <i class="bi bi-clock-history fs-5"></i>
                </div>
            </div>
            <div class="mt-2 pt-2 border-top border-dark-subtle small">
                Cần nhà cung cấp xác nhận
            </div>
        </div>
    </div>
</div>

<!-- 4 PHÂN HỆ QUẢN TRỊ TRỌNG TÂM -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 d-flex flex-row align-items-center justify-content-between bg-white h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-primary-subtle text-primary p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="bi bi-people-fill fs-5"></i>
                </div>
                <div>
                    <h5 class="fw-bold mb-1 text-dark">Quản lý Tài Khoản Người Dùng</h5>
                    <p class="text-muted small mb-0">Phân tách danh sách Khách hàng và Đối tác/Nhân viên.</p>
                </div>
            </div>
            <a asp-action="Users" class="btn btn-outline-primary fw-bold text-nowrap rounded-pill px-3">Vào quản lý</a>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 d-flex flex-row align-items-center justify-content-between bg-white h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-success-subtle text-success p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="bi bi-graph-up-arrow fs-5"></i>
                </div>
                <div>
                    <h5 class="fw-bold mb-1 text-dark">Thống Kê Doanh Thu & Hiệu Suất</h5>
                    <p class="text-muted small mb-0">Biểu đồ doanh thu ngày/tháng/năm, lọc và xuất Excel/PDF.</p>
                </div>
            </div>
            <a asp-action="Statistics" class="btn btn-outline-success fw-bold text-nowrap rounded-pill px-3">Xem thống kê</a>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 d-flex flex-row align-items-center justify-content-between bg-white h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-warning-subtle text-warning-emphasis p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="bi bi-star-fill fs-5"></i>
                </div>
                <div>
                    <h5 class="fw-bold mb-1 text-dark">Quản Lý Đánh Giá Toàn Hệ Thống</h5>
                    <p class="text-muted small mb-0">Thống kê số sao từng nhà cung cấp và nhận xét từ khách hàng.</p>
                </div>
            </div>
            <a asp-action="Reviews" class="btn btn-outline-warning text-dark fw-bold text-nowrap rounded-pill px-3">Xem đánh giá</a>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 d-flex flex-row align-items-center justify-content-between bg-white h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-info-subtle text-info-emphasis p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="bi bi-tags-fill fs-5"></i>
                </div>
                <div>
                    <h5 class="fw-bold mb-1 text-dark">Quản lý Danh Mục Dịch Vụ</h5>
                    <p class="text-muted small mb-0">Thêm, sửa, xóa và sử dụng AI gợi ý danh mục mới chưa có.</p>
                </div>
            </div>
            <a asp-action="Categories" class="btn btn-outline-info fw-bold text-nowrap rounded-pill px-3">Vào danh mục</a>
        </div>
    </div>
</div>

<!-- US-AI-05: AI Business Insights & Dự báo xu hướng -->
<div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-3">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-primary text-white rounded-3 p-2.5 d-flex align-items-center justify-content-center shadow-sm" style="width: 44px; height: 44px;">
                <i class="bi bi-lightbulb-fill fs-5"></i>
            </div>
            <div>
                <h5 class="fw-bold mb-0 text-dark">AI Business Insights & Dự Báo Vận Hành</h5>
                <small class="text-secondary">Phân tích chuyên sâu từ dữ liệu lịch hẹn và tình trạng dịch vụ thời gian thực</small>
            </div>
        </div>
        <button id="btnAiStatsAdmin" class="btn btn-outline-primary rounded-pill px-3 py-1.5 fw-semibold d-flex align-items-center gap-1.5 text-nowrap">
            <i class="bi bi-magic"></i>
            <span>Tạo Báo Cáo AI</span>
        </button>
    </div>

    <div id="aiStatsAdminLoading" class="text-center py-4 d-none">
        <div class="spinner-border text-primary spinner-border-sm mb-2" role="status"></div>
        <div class="text-secondary small">AI đang phân tích các chỉ số vận hành hệ thống...</div>
    </div>

    <div id="aiStatsAdminResult" class="p-3 bg-light rounded-3 text-dark small d-none" style="white-space: pre-wrap; line-height: 1.6;">
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const btn = document.getElementById("btnAiStatsAdmin");
        const loading = document.getElementById("aiStatsAdminLoading");
        const result = document.getElementById("aiStatsAdminResult");

        if (btn) {
            btn.addEventListener("click", function () {
                loading.classList.remove("d-none");
                result.classList.add("d-none");
                btn.disabled = true;

                fetch('/Ai/AnalyzeStats')
                    .then(res => res.json())
                    .then(data => {
                        loading.classList.add("d-none");
                        btn.disabled = false;
                        if (data && data.success) {
                            result.innerHTML = data.analysis;
                            result.classList.remove("d-none");
                        } else {
                            result.innerHTML = `<span class="text-danger">${data.message || 'Không thể tạo báo cáo lúc này.'}</span>`;
                            result.classList.remove("d-none");
                        }
                    })
                    .catch(err => {
                        loading.classList.add("d-none");
                        btn.disabled = false;
                        result.innerHTML = `<span class="text-danger">Lỗi kết nối khi gửi yêu cầu phân tích.</span>`;
                        result.classList.remove("d-none");
                    });
            });
        }
    });
</script>
}
