@model Appointment.Models.ViewModels.CreateUserByAdminViewModel
@{
    ViewData["Title"] = "Admin - Tạo tài khoản mới";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-warning text-dark py-3 rounded-top-4">
                <h4 class="fw-bold mb-0">Admin Tạo Tài Khoản Mới</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="CreateUser" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold">Họ và tên</label>
                        <input asp-for="FullName" class="form-control" placeholder="Nguyễn Văn B" required autofocus />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold">Địa chỉ Email</label>
                        <input asp-for="Email" class="form-control" placeholder="user@appointx.com" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Role" class="form-label fw-bold text-primary">Vai trò trong hệ thống (Role)</label>
                        <select asp-for="Role" class="form-select form-select-lg border-primary">
                            <option value="Customer">Customer (Khách hàng sử dụng dịch vụ)</option>
                            <option value="Provider">Provider (Nhà cung cấp dịch vụ / Bác sĩ / Salon)</option>
                            <option value="Staff">Staff (Nhân viên hỗ trợ hệ thống)</option>
                            <option value="Admin">Admin (Quản trị viên toàn quyền)</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold">Mật khẩu khởi tạo</label>
                        <input asp-for="Password" class="form-control" placeholder="Mật khẩu tối thiểu 6 ký tự" required />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold">Số điện thoại</label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="09xxxxxxx" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Address" class="form-label fw-semibold">Địa chỉ</label>
                            <input asp-for="Address" class="form-control" placeholder="Địa chỉ cơ sở/cá nhân" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Users" class="btn btn-outline-secondary">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary fw-bold px-4">Tạo Tài Khoản</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
