@model Appointment.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<div class="row justify-content-center my-4">
    <div class="col-md-7 col-lg-5">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
            <div class="p-4 pt-5 pb-3 text-center border-bottom bg-slate-50">
                <div class="d-inline-flex align-items-center justify-content-center brand-badge mb-2 shadow-sm" style="width: 48px; height: 48px; font-size: 1.5rem;">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <h3 class="fw-extrabold text-dark mb-1">Đặt Lại Mật Khẩu</h3>
                <p class="text-secondary small mb-0">Tạo mật khẩu mới cho tài khoản <strong>@Model.Email</strong></p>
            </div>

            <div class="card-body p-4 p-md-5 pt-4">
                @if (!Model.IsTokenValid)
                {
                    <div class="text-center">
                        <div class="mb-3 text-danger" style="font-size: 3rem;"><i class="bi bi-x-octagon-fill"></i></div>
                        <h5 class="fw-bold text-dark">Liên kết không hợp lệ hoặc đã hết hạn</h5>
                        <p class="text-secondary small mb-4">Liên kết đặt lại mật khẩu chỉ có hiệu lực trong 30 phút và chỉ dùng được một lần. Vui lòng yêu cầu liên kết mới.</p>
                        <a asp-action="ForgotPassword" class="btn btn-primary rounded-pill px-4 fw-bold">Yêu cầu liên kết mới</a>
                    </div>
                }
                else
                {
                    <form asp-action="ResetPassword" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small rounded-3 mb-3 border-0 shadow-sm"></div>
                        <input type="hidden" asp-for="Email" />
                        <input type="hidden" asp-for="Token" />

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label fw-bold text-secondary small">
                                <i class="bi bi-lock me-1"></i>Mật khẩu mới
                            </label>
                            <input asp-for="NewPassword" class="form-control rounded-3 py-2" placeholder="Tối thiểu 6 ký tự" autofocus />
                            <span asp-validation-for="NewPassword" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmNewPassword" class="form-label fw-bold text-secondary small">
                                <i class="bi bi-lock-fill me-1"></i>Xác nhận mật khẩu mới
                            </label>
                            <input asp-for="ConfirmNewPassword" class="form-control rounded-3 py-2" placeholder="Nhập lại mật khẩu mới" />
                            <span asp-validation-for="ConfirmNewPassword" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold rounded-3 shadow-sm d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-check2-circle"></i>
                            <span>Đặt lại mật khẩu</span>
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
