@model Appointment.Models.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="container-fluid py-2">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8 col-sm-10">
            <!-- Breadcrumb / Back button -->
            <div class="mb-4">
                <a asp-action="Profile" class="text-decoration-none text-secondary small d-inline-flex align-items-center gap-1 mb-2">
                    <i class="bi bi-arrow-left"></i> Quay lại Hồ sơ cá nhân
                </a>
                <h4 class="fw-bold mb-1 text-dark">
                    <i class="bi bi-shield-lock-fill text-primary me-2"></i>Đổi Mật Khẩu
                </h4>
                <p class="text-secondary small mb-0">Cập nhật mật khẩu mới để tăng cường tính bảo mật cho tài khoản</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-4 mb-4" role="alert">
                    <div class="d-flex align-items-start gap-2">
                        <i class="bi bi-exclamation-triangle-fill fs-5 mt-1 text-danger"></i>
                        <div class="flex-grow-1">
                            <strong>Đổi mật khẩu không thành công:</strong>
                            <div asp-validation-summary="All" class="text-danger small mt-1 mb-0"></div>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <form asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()

                    <!-- Mật khẩu hiện tại -->
                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label fw-bold text-dark small">
                            Mật khẩu hiện tại <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-secondary rounded-start-3">
                                <i class="bi bi-lock"></i>
                            </span>
                            <input asp-for="CurrentPassword" type="password" id="currentPasswordInput" class="form-control border-start-0 border-end-0" placeholder="Nhập mật khẩu hiện tại" autocomplete="current-password" />
                            <button class="btn btn-light border border-start-0 text-secondary rounded-end-3" type="button" onclick="togglePasswordVisibility('currentPasswordInput', this)">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <!-- Mật khẩu mới -->
                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-bold text-dark small">
                            Mật khẩu mới <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-secondary rounded-start-3">
                                <i class="bi bi-shield-check"></i>
                            </span>
                            <input asp-for="NewPassword" type="password" id="newPasswordInput" class="form-control border-start-0 border-end-0" placeholder="Mật khẩu tối thiểu 6 ký tự" autocomplete="new-password" />
                            <button class="btn btn-light border border-start-0 text-secondary rounded-end-3" type="button" onclick="togglePasswordVisibility('newPasswordInput', this)">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <!-- Xác nhận mật khẩu mới -->
                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-bold text-dark small">
                            Xác nhận mật khẩu mới <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-secondary rounded-start-3">
                                <i class="bi bi-check2-circle"></i>
                            </span>
                            <input asp-for="ConfirmPassword" type="password" id="confirmPasswordInput" class="form-control border-start-0 border-end-0" placeholder="Nhập lại mật khẩu mới" autocomplete="new-password" />
                            <button class="btn btn-light border border-start-0 text-secondary rounded-end-3" type="button" onclick="togglePasswordVisibility('confirmPasswordInput', this)">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <!-- Quy định mật khẩu -->
                    <div class="p-3 bg-light rounded-3 border mb-4 small text-secondary">
                        <div class="fw-bold mb-1 text-dark"><i class="bi bi-info-circle text-primary me-1"></i>Lưu ý về mật khẩu:</div>
                        <ul class="mb-0 ps-3">
                            <li>Mật khẩu mới phải có độ dài từ 6 ký tự trở lên.</li>
                            <li>Mật khẩu mới không được trùng với mật khẩu hiện tại.</li>
                            <li>Nên kết hợp chữ cái hoa, chữ thường, số và ký tự đặc biệt.</li>
                        </ul>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                        <a asp-action="Profile" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold">
                            Hủy
                        </a>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm d-inline-flex align-items-center gap-2">
                            <i class="bi bi-shield-lock"></i>
                            <span>Cập Nhật Mật Khẩu</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePasswordVisibility(inputId, button) {
            const input = document.getElementById(inputId);
            const icon = button.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }
    </script>
}
