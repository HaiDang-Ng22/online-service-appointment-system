@model Appointment.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="row justify-content-center my-4">
    <div class="col-md-7 col-lg-5">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
            <div class="p-4 pt-5 pb-3 text-center border-bottom bg-slate-50">
                <div class="d-inline-flex align-items-center justify-content-center brand-badge mb-2 shadow-sm" style="width: 48px; height: 48px; font-size: 1.5rem;">
                    <i class="bi bi-envelope-paper-fill"></i>
                </div>
                <h3 class="fw-extrabold text-dark mb-1">Quên Mật Khẩu</h3>
                <p class="text-secondary small mb-0">Nhập email đã đăng ký, chúng tôi sẽ gửi liên kết đặt lại mật khẩu</p>
            </div>

            <div class="card-body p-4 p-md-5 pt-4">
                <form asp-action="ForgotPassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small rounded-3 mb-3 border-0 shadow-sm"></div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label fw-bold text-secondary small">
                            <i class="bi bi-envelope-at me-1"></i>Địa chỉ Email
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted rounded-start-3">
                                <i class="bi bi-person"></i>
                            </span>
                            <input asp-for="Email" class="form-control border-start-0 rounded-end-3 py-2" placeholder="name@example.com" autofocus />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-bold rounded-3 shadow-sm d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-send-fill"></i>
                        <span>Gửi liên kết đặt lại mật khẩu</span>
                    </button>
                </form>

                <div class="text-center mt-4">
                    <a asp-action="Login" class="fw-bold text-primary text-decoration-none small">
                        <i class="bi bi-arrow-left"></i> Quay lại đăng nhập
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
