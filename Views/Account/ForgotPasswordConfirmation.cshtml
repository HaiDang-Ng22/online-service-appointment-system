@{
    ViewData["Title"] = "Đã gửi email đặt lại mật khẩu";
    var devLink = TempData["DevResetLink"] as string;
}

<div class="row justify-content-center my-4">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-lg rounded-4 bg-white p-4 p-md-5 text-center">
            <div class="mb-3 text-success" style="font-size: 3.5rem;">
                <i class="bi bi-envelope-check-fill"></i>
            </div>
            <h3 class="fw-bold text-dark mb-2">Vui lòng kiểm tra email của bạn</h3>
            <p class="text-secondary mb-1">
                Nếu email bạn nhập đã được đăng ký, chúng tôi vừa gửi một liên kết đặt lại mật khẩu.
            </p>
            <p class="text-secondary small mb-4">Liên kết có hiệu lực trong 30 phút và chỉ dùng được một lần. Hãy kiểm tra cả thư mục Spam.</p>

            @if (!string.IsNullOrEmpty(devLink))
            {
                <div class="alert alert-warning text-start small rounded-3 border-0 shadow-sm">
                    <strong><i class="bi bi-tools me-1"></i>Chế độ phát triển (SMTP chưa cấu hình):</strong>
                    <div class="mt-1">Dùng liên kết sau để đặt lại mật khẩu:</div>
                    <a href="@devLink" class="text-break">@devLink</a>
                    <div class="mt-1 text-muted">Hộp thông báo này chỉ hiện khi chạy ở môi trường Development.</div>
                </div>
            }

            <div class="d-flex justify-content-center gap-2">
                <a asp-action="Login" class="btn btn-primary rounded-pill px-4 fw-bold">Về trang đăng nhập</a>
                <a asp-action="ForgotPassword" class="btn btn-outline-secondary rounded-pill px-4">Gửi lại</a>
            </div>
        </div>
    </div>
</div>
