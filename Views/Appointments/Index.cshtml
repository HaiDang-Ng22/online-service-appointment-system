@model List<Appointment.Models.AppointmentModel>
@{
    ViewData["Title"] = "Lịch hẹn của tôi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0 text-primary">Lịch Hẹn Của Tôi</h3>
    <a asp-controller="Services" asp-action="Index" class="btn btn-primary fw-bold">Đặt Lịch Dịch Vụ Mới</a>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
        <h4 class="fw-bold">Bạn chưa có lịch hẹn nào</h4>
        <p class="text-muted">Hãy tìm kiếm dịch vụ yêu thích và chọn khung giờ phù hợp để đặt lịch.</p>
        <div>
            <a asp-controller="Services" asp-action="Index" class="btn btn-primary px-4 py-2 fw-bold rounded-pill">Khám phá ngay</a>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Dịch vụ</th>
                        <th>Nhà cung cấp</th>
                        <th>Ngày hẹn</th>
                        <th>Khung giờ</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <strong class="text-dark">@item.Service?.Name</strong>
                            </td>
                            <td>@item.Provider?.FullName</td>
                            <td>@item.AppointmentDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")
                                </span>
                            </td>
                            <td>
                                @if (item.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">Chờ xác nhận</span>
                                }
                                else if (item.Status == "Confirmed")
                                {
                                    <span class="badge bg-info text-white">Đã xác nhận</span>
                                }
                                else if (item.Status == "Completed")
                                {
                                    <span class="badge bg-success">Đã hoàn thành</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Đã hủy</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm me-1">Chi tiết</a>

                                @if (item.Status == "Pending" || item.Status == "Confirmed")
                                {
                                    <form asp-action="Cancel" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn hủy lịch hẹn này?');">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Hủy lịch</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
