@model Appointment.Models.ViewModels.BookingViewModel
@{
    ViewData["Title"] = Model.ServiceName + " - Đặt lịch";
    var service = ViewBag.Service as Appointment.Models.Service;
}

<div class="row g-4 my-2">
    <!-- Service Info Column -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white sticky-lg-top" style="top: 80px;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="badge bg-primary-subtle text-primary fw-semibold px-3 py-2 rounded-2">
                    <i class="bi bi-tag-fill me-1"></i>@Model.CategoryName
                </span>
                <span class="badge bg-success-subtle text-success small px-2 py-1">
                    <i class="bi bi-patch-check-fill me-1"></i>Đã kiểm duyệt
                </span>
            </div>

            <h3 class="fw-bold text-dark mb-2">@Model.ServiceName</h3>

            <div class="fs-3 text-success fw-extrabold mb-4">
                @Model.Price.ToString("N0") <span class="fs-6 text-muted fw-semibold">VNĐ</span>
            </div>

            <div class="service-meta-box mb-4">
                <div class="service-meta-row mb-2">
                    <i class="bi bi-building-check text-primary fs-5"></i>
                    <div>
                        <div class="small text-muted">Nhà cung cấp</div>
                        <strong>@Model.ProviderName</strong>
                    </div>
                </div>
                <div class="service-meta-row mb-2">
                    <i class="bi bi-clock-history text-secondary fs-5"></i>
                    <div>
                        <div class="small text-muted">Thời lượng dịch vụ</div>
                        <strong>@Model.DurationMinutes phút</strong>
                    </div>
                </div>
                <div class="service-meta-row">
                    <i class="bi bi-geo-alt-fill text-danger fs-5"></i>
                    <div>
                        <div class="small text-muted">Địa điểm thực hiện</div>
                        <strong>@(service?.Location ?? "Tại cơ sở nhà cung cấp")</strong>
                    </div>
                </div>
            </div>

            <h6 class="fw-bold text-dark mb-2">
                <i class="bi bi-info-circle me-1 text-primary"></i>Mô tả chi tiết
            </h6>
            <p class="text-secondary small line-height-lg mb-4">
                @(service?.Description ?? "Không có mô tả chi tiết.")
            </p>

            <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3 align-self-start">
                <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
            </a>
        </div>
    </div>

    <!-- Booking Form Column -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            <div class="d-flex align-items-center gap-2 mb-3">
                <span class="brand-badge" style="width: 38px; height: 38px; font-size: 1.1rem;">
                    <i class="bi bi-calendar2-week-fill text-white"></i>
                </span>
                <div>
                    <h4 class="fw-bold mb-0 text-dark">Chọn Thời Gian & Đặt Lịch</h4>
                    <small class="text-secondary">Chọn ngày và khung giờ bạn mong muốn tiếp nhận dịch vụ</small>
                </div>
            </div>

            <!-- Date Selector Form -->
            <form asp-action="Details" method="get" class="row g-2 mb-4 align-items-center bg-light p-3 rounded-3">
                <input type="hidden" name="id" value="@Model.ServiceId" />
                <div class="col-sm-8">
                    <label class="form-label fw-bold small text-secondary mb-1">
                        <i class="bi bi-calendar-event me-1 text-primary"></i>Ngày đặt lịch:
                    </label>
                    <input type="date" name="selectedDate" class="form-control rounded-3" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" min="@DateTime.Today.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
                </div>
                <div class="col-sm-4 pt-sm-4">
                    <button type="submit" class="btn btn-secondary w-100 rounded-3 fw-bold">
                        <i class="bi bi-arrow-clockwise me-1"></i>Tải lịch
                    </button>
                </div>
            </form>

            <!-- Off Day Alert -->
            @if (Model.IsProviderOffDay)
            {
                <div class="alert alert-danger border-0 shadow-sm py-3 px-4 rounded-3 mb-4 d-flex align-items-start gap-3">
                    <i class="bi bi-exclamation-octagon-fill fs-3 text-danger"></i>
                    <div>
                        <h6 class="fw-bold mb-1">Nhà cung cấp tạm nghỉ vào ngày này</h6>
                        <p class="mb-1 small">Ngày <strong>@Model.SelectedDate.ToString("dd/MM/yyyy")</strong> cơ sở không tiếp nhận lịch hẹn. @(string.IsNullOrEmpty(Model.OffDayReason) ? "" : $"Lý do: {Model.OffDayReason}")</p>
                        <small class="fw-bold text-danger">Vui lòng chọn ngày khác trên thanh chọn ngày ở trên.</small>
                    </div>
                </div>
            }

            <!-- Auth Alert -->
            @if (!User.Identity?.IsAuthenticated == true)
            {
                <div class="alert alert-warning border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill fs-5 text-warning"></i>
                    <div>
                        Bạn cần <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="fw-bold text-dark text-decoration-underline">Đăng nhập</a> tài khoản để tiến hành đặt lịch.
                    </div>
                </div>
            }
            else if (!User.IsInRole("Customer") && !User.IsInRole("Admin"))
            {
                <div class="alert alert-info border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2">
                    <i class="bi bi-info-circle-fill fs-5 text-primary"></i>
                    <div>
                        Tài khoản hiện tại có vai trò <strong>@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</strong> (chế độ xem trước khung giờ trống).
                    </div>
                </div>
            }

            <form asp-controller="Appointments" asp-action="Book" method="post" id="bookingForm">
                <input type="hidden" asp-for="ServiceId" />
                <input type="hidden" asp-for="SelectedDate" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-clock me-1 text-primary"></i>Khung giờ khả dụng ngày @Model.SelectedDate.ToString("dd/MM/yyyy"):
                    </h6>
                    <small class="text-secondary">(Mỗi khung giờ: @Model.DurationMinutes phút)</small>
                </div>

                <div class="row g-2 mb-4">
                    @if (Model.IsProviderOffDay)
                    {
                        <div class="col-12 py-3 text-center text-muted bg-light rounded-3">
                            <i class="bi bi-calendar-x me-1 text-danger"></i> Không có khung giờ do cửa hàng đóng cửa ngày này.
                        </div>
                    }
                    else if (!Model.AvailableSlots.Any())
                    {
                        <div class="col-12 py-3 text-center text-muted bg-light rounded-3">
                            <i class="bi bi-calendar-minus me-1"></i> Nhà cung cấp không có khung giờ hoạt động trong ngày được chọn.
                        </div>
                    }
                    else
                    {
                        @foreach (var slot in Model.AvailableSlots)
                        {
                            <div class="col-6 col-sm-4 col-md-3">
                                @if (slot.IsAvailable)
                                {
                                    <input type="radio" class="btn-check" name="SelectedTimeSlot" id="slot_@slot.TimeFormatted.Replace(":", "_")" value="@slot.TimeFormatted" required />
                                    <label class="btn btn-outline-primary w-100 py-2 fw-bold rounded-3" for="slot_@slot.TimeFormatted.Replace(":", "_")">
                                        @slot.TimeFormatted
                                    </label>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-outline-secondary w-100 py-2 disabled rounded-3 opacity-50" disabled title="Khung giờ đã có người đặt hoặc đã qua">
                                        @slot.TimeFormatted
                                    </button>
                                }
                            </div>
                        }
                    }
                </div>

                <div class="mb-4">
                    <label asp-for="Notes" class="form-label fw-bold text-secondary small">
                        <i class="bi bi-pencil-square me-1 text-primary"></i>Ghi chú cho nhà cung cấp (nếu có)
                    </label>
                    <textarea asp-for="Notes" class="form-control rounded-3" rows="3" placeholder="Ví dụ: Triệu chứng cần khám, kiểu tóc mong muốn, lưu ý dị ứng hoặc yêu cầu đặc biệt..."></textarea>
                </div>

                @if (User.Identity?.IsAuthenticated == true && (User.IsInRole("Customer") || User.IsInRole("Admin")) && !Model.IsProviderOffDay)
                {
                    <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold py-3 rounded-3 shadow d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-calendar2-check-fill"></i>
                        <span>Xác Nhận Đặt Lịch Hẹn Ngay</span>
                    </button>
                }
            </form>
        </div>
    </div>
</div>
