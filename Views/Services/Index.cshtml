@model List<Appointment.Models.Service>
@{
    ViewData["Title"] = "Dịch vụ & Tìm kiếm";
    var categories = ViewBag.Categories as List<Appointment.Models.Category> ?? new();
}

<div class="row g-4">
    <!-- Filter sidebar -->
    <div class="col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 p-4 sticky-lg-top" style="top: 80px;">
            <div class="d-flex align-items-center gap-2 mb-3">
                <i class="bi bi-funnel-fill text-primary fs-5"></i>
                <h5 class="fw-bold mb-0 text-dark">Bộ Lọc Tìm Kiếm</h5>
            </div>
            
            <form asp-action="Index" method="get">
                <div class="mb-3">
                    <label class="form-label small fw-bold text-secondary">
                        <i class="bi bi-search me-1"></i>Từ khóa
                    </label>
                    <input type="text" name="search" class="form-control rounded-3" placeholder="Tên dịch vụ, nhà cung cấp..." value="@ViewBag.SearchTerm" />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold text-secondary">
                        <i class="bi bi-tags me-1"></i>Danh mục dịch vụ
                    </label>
                    <select name="categoryId" class="form-select rounded-3">
                        <option value="">-- Tất cả danh mục --</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.Id" selected="@(ViewBag.SelectedCategoryId == cat.Id ? "selected" : null)">@cat.Name</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold text-secondary">
                        <i class="bi bi-cash-stack me-1"></i>Khoảng giá (VNĐ)
                    </label>
                    <div class="row g-2">
                        <div class="col-6">
                            <input type="number" name="minPrice" class="form-control rounded-3" placeholder="Từ" value="@ViewBag.MinPrice" />
                        </div>
                        <div class="col-6">
                            <input type="number" name="maxPrice" class="form-control rounded-3" placeholder="Đến" value="@ViewBag.MaxPrice" />
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-bold text-secondary">
                        <i class="bi bi-geo-alt me-1"></i>Địa điểm
                    </label>
                    <input type="text" name="location" class="form-control rounded-3" placeholder="Hà Nội, TP.HCM..." value="@ViewBag.Location" />
                </div>

                <button type="submit" class="btn btn-primary w-100 fw-bold rounded-3 py-2 shadow-sm">
                    <i class="bi bi-search me-1"></i> Áp Dụng Lọc
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary w-100 rounded-3 mt-2 btn-sm">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Xóa bộ lọc
                </a>
            </form>
        </div>
    </div>

    <!-- Service listing -->
    <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h4 class="fw-bold mb-1 text-dark">Danh Sách Dịch Vụ</h4>
                <p class="text-secondary small mb-0">Tìm thấy <strong>@Model.Count</strong> dịch vụ phù hợp</p>
            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="card border-0 shadow-sm rounded-4 text-center py-5 px-4 bg-white">
                <div class="text-muted mb-3" style="font-size: 3rem;">
                    <i class="bi bi-search-heart"></i>
                </div>
                <h5 class="fw-bold text-dark">Không tìm thấy dịch vụ phù hợp</h5>
                <p class="text-secondary small mb-3">Vui lòng thử điều chỉnh lại từ khóa hoặc xóa bớt tiêu chí lọc.</p>
                <div>
                    <a asp-action="Index" class="btn btn-primary btn-sm rounded-pill px-4">
                        Xem tất cả dịch vụ
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var item in Model)
                {
                    <div class="col-md-6">
                        <div class="service-card">
                            <div class="service-card-header">
                                <span class="badge bg-primary-subtle text-primary fw-semibold px-2 py-1 rounded-2">
                                    <i class="bi bi-tag-fill me-1"></i>@item.Category?.Name
                                </span>
                                <span class="service-price-tag">@item.Price.ToString("N0") VNĐ</span>
                            </div>

                            <div class="service-card-body">
                                <h5 class="service-name">@item.Name</h5>
                                <p class="service-desc">@item.Description</p>

                                <div class="service-meta-box">
                                    <div class="service-meta-row">
                                        <i class="bi bi-building-check"></i>
                                        <span>Nhà cung cấp: <strong>@item.Provider?.FullName</strong></span>
                                    </div>
                                    <div class="service-meta-row">
                                        <i class="bi bi-clock-history"></i>
                                        <span>Thời lượng: <strong>@item.DurationMinutes phút</strong></span>
                                    </div>
                                    <div class="service-meta-row">
                                        <i class="bi bi-geo-alt-fill text-danger"></i>
                                        <span class="text-truncate">Địa điểm: <strong>@item.Location</strong></span>
                                    </div>
                                </div>
                            </div>

                            <div class="service-card-footer">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn-book-service">
                                    <i class="bi bi-calendar2-check"></i> Xem Lịch Trống & Đặt
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
