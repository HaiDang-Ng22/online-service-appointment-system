<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AppointX</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm py-3">
            <div class="container">
                <a class="navbar-brand fw-bold fs-4" asp-area="" asp-controller="@(User.IsInRole("Admin") ? "Admin" : User.IsInRole("Provider") ? "Provider" : User.IsInRole("Staff") ? "Staff" : "Home")" asp-action="Index">
                    AppointX
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (!User.Identity?.IsAuthenticated == true)
                        {
                            <!-- Guest Links -->
                            <li class="nav-item">
                                <a class="nav-link text-white fw-semibold" asp-controller="Home" asp-action="Index">Trang chủ</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white fw-semibold" asp-controller="Services" asp-action="Index">Dịch vụ & Tìm kiếm</a>
                            </li>
                        }
                        else if (User.IsInRole("Customer"))
                        {
                            <!-- Customer Links -->
                            <li class="nav-item">
                                <a class="nav-link text-white fw-semibold" asp-controller="Home" asp-action="Index">Trang chủ</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white fw-semibold" asp-controller="Services" asp-action="Index">Dịch vụ & Tìm kiếm</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white fw-semibold" asp-controller="Appointments" asp-action="Index">Lịch hẹn của tôi</a>
                            </li>
                        }
                        else if (User.IsInRole("Provider"))
                        {
                            <!-- Provider Links Only -->
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-bold" asp-controller="Provider" asp-action="Index">Kênh Provider</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white fw-semibold" asp-controller="Provider" asp-action="Services">Quản lý Dịch vụ</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white fw-semibold" asp-controller="Provider" asp-action="OffDays">Quản lý Ngày nghỉ</a>
                            </li>
                        }
                        else if (User.IsInRole("Staff"))
                        {
                            <!-- Staff Links Only -->
                            <li class="nav-item">
                                <a class="nav-link text-info fw-bold" asp-controller="Staff" asp-action="Index">Kênh Nhân viên</a>
                            </li>
                        }
                        else if (User.IsInRole("Admin"))
                        {
                            <!-- Admin Links Only -->
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-bold" asp-controller="Admin" asp-action="Index">Trang Admin</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white fw-semibold" asp-controller="Admin" asp-action="Users">Quản lý Tài khoản</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white fw-semibold" asp-controller="Admin" asp-action="Categories">Danh mục</a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white fw-bold" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @User.Identity.Name
                                    <span class="badge bg-light text-dark ms-1">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userDropdown">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Profile">Thông tin cá nhân</a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            <button type="submit" class="dropdown-item text-danger fw-semibold">Đăng xuất</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-light me-2 btn-sm px-3" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-warning btn-sm px-3 fw-bold text-dark" asp-controller="Account" asp-action="Register">Đăng ký (Khách hàng)</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-4 flex-grow-1">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer border-top bg-dark text-white py-4 mt-auto">
        <div class="container text-center">
            <p class="mb-1">&copy; 2026 <strong>AppointX</strong> - Hệ thống quản lý & Đặt lịch dịch vụ trực tuyến.</p>
            <small class="text-secondary">Đồ án Công nghệ phần mềm nâng cao | ASP.NET Core & PostgreSQL</small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
